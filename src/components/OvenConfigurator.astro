<section class="configurator" id="powceq-configurator">
  <div class="heading"><div><span class="eyebrow">POWCEQ • CONFIGURE YOUR EQUIPMENT</span><h1>Powder Coating Curing Oven</h1><p>Configure your oven and inspect it in interactive 3D.</p></div><span class="pill">3D configurator · Prototype</span></div>
  <div class="layout">
    <div class="viewer"><div id="oven-canvas" role="img" aria-label="Interactive 3D curing oven preview"></div><div class="viewer-top">Drag to rotate · Scroll to zoom</div><div class="viewer-bottom"><button id="reset-camera" type="button">Reset view</button><button id="toggle-doors" type="button">Open doors</button></div></div>
    <div class="panel"><h2>Machine configuration</h2><p class="hint">Internal working dimensions (mm)</p>
      <label for="width">Width <output id="width-val">2000 mm</output></label><input id="width" type="range" min="1000" max="4000" step="100" value="2000"/>
      <label for="depth">Depth <output id="depth-val">3000 mm</output></label><input id="depth" type="range" min="1500" max="8000" step="100" value="3000"/>
      <label for="height">Height <output id="height-val">2200 mm</output></label><input id="height" type="range" min="1500" max="3500" step="100" value="2200"/>
      <label for="heating">Heating system</label><select id="heating"><option value="Electric">Electric</option><option value="Gas">Gas</option><option value="Hybrid">Hybrid (gas + electric)</option></select>
      <label for="color">Exterior finish</label><select id="color"><option value="Graphite">Graphite grey</option><option value="Blue">Industrial blue</option><option value="Light grey">Light grey</option></select>
      <div class="summary"><strong>Configuration summary</strong><div id="summary-text" aria-live="polite"></div><small>Dimensions are conceptual internal dimensions. Final external dimensions, thermal performance and price require engineering confirmation.</small></div>
      <button class="primary" id="quote" type="button">Request quotation by email</button><button class="secondary" id="download" type="button">Download configuration (.json)</button>
    </div>
  </div>
</section>
<style>
:global(body){margin:0;background:#f3f5f8;color:#1b2939;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}.configurator{max-width:1320px;margin:auto;padding:32px 20px 60px}.heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:700;color:#2867a8}h1{font-size:clamp(25px,3vw,38px);margin:8px 0}p{color:#617085}.pill{background:#e6edf6;color:#285d92;border-radius:30px;padding:9px 15px;font-size:12px;white-space:nowrap}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);gap:20px}.viewer,.panel{background:#fff;border:1px solid #e0e6ed;border-radius:16px;overflow:hidden;box-shadow:0 8px 25px #1c36570b}.viewer{position:relative;min-height:570px;background:radial-gradient(circle at 50% 40%,#f9fcff,#dce5ef)}#oven-canvas{position:absolute;inset:0;touch-action:none}#oven-canvas canvas{display:block;width:100%;height:100%}.viewer-top{position:absolute;top:18px;left:18px;background:#ffffffd9;border-radius:8px;padding:10px;font-size:12px;color:#43536a;pointer-events:none}.viewer-bottom{position:absolute;bottom:18px;left:18px;right:18px;display:flex;justify-content:space-between;gap:10px}.viewer-bottom button{border:1px solid #c8d4e1;background:#ffffffed;padding:10px 14px;border-radius:8px;cursor:pointer}.panel{padding:24px}.panel h2{font-size:20px;margin:0 0 5px}.hint{font-size:13px;margin:0 0 22px}label{display:flex;justify-content:space-between;gap:8px;font-size:14px;font-weight:600;margin:18px 0 8px}output{color:#2461a4;font-variant-numeric:tabular-nums}input[type=range]{width:100%;accent-color:#1c66a6;cursor:pointer}select{width:100%;padding:12px;border:1px solid #ccd6e0;border-radius:8px;background:#fff;color:#24344a}.summary{background:#f3f7fb;border:1px solid #e0e9f2;border-radius:10px;padding:16px;margin:24px 0 14px}.summary strong{display:block;margin-bottom:10px}.summary #summary-text{line-height:1.8;font-size:14px}.summary small{display:block;margin-top:12px;color:#69788b;line-height:1.5}.primary,.secondary{display:block;width:100%;border-radius:9px;padding:14px;font-size:14px;font-weight:700;cursor:pointer}.primary{background:#1766a9;color:#fff;border:0}.secondary{margin-top:10px;background:#fff;border:1px solid #cad6e2;color:#1d4e79}@media(max-width:850px){.layout{grid-template-columns:1fr}.viewer{min-height:430px}.heading{align-items:flex-start;flex-direction:column}.panel{padding:18px}}@media(max-width:480px){.viewer{min-height:330px}.viewer-bottom button{font-size:12px;padding:9px}}
</style>
<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
const root=document.getElementById('powceq-configurator');
if(root && !root.dataset.initialized){
root.dataset.initialized='true';
const $=(id)=>root.querySelector('#'+id);
const holder=$('oven-canvas');
const scene=new THREE.Scene();scene.background=new THREE.Color('#e9eff6');
const camera=new THREE.PerspectiveCamera(42,1,.1,100);
camera.position.set(6,4.2,7);
const renderer=new THREE.WebGLRenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;holder.appendChild(renderer.domElement);
const controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.minDistance=3;controls.maxDistance=25;controls.maxPolarAngle=Math.PI/2-.04;controls.target.set(0,1.5,0);
scene.add(new THREE.HemisphereLight(0xffffff,0x75879d,2.3));const sun=new THREE.DirectionalLight(0xffffff,3);sun.position.set(5,10,8);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);sun.shadow.camera.left=-10;sun.shadow.camera.right=10;sun.shadow.camera.top=10;sun.shadow.camera.bottom=-10;scene.add(sun);
const floor=new THREE.Mesh(new THREE.PlaneGeometry(100,100),new THREE.MeshStandardMaterial({color:0xdce4ee,roughness:1}));floor.rotation.x=-Math.PI/2;floor.receiveShadow=true;scene.add(floor);
const group=new THREE.Group();scene.add(group);
let doorLeft,doorRight,doorsOpen=false;
function mat(color,metalness=.35){return new THREE.MeshStandardMaterial({color,metalness,roughness:.52});}
function cube(parent,w,h,d,x,y,z,material){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;parent.add(m);return m;}
function config(){return {machine:'Powder coating batch curing oven',internalWidthMm:+$('width').value,internalDepthMm:+$('depth').value,internalHeightMm:+$('height').value,heating:$('heating').value,finish:$('color').value,doors:'Double hinged front doors'};}
function rebuild(){
 while(group.children.length){const obj=group.children[0];group.remove(obj);obj.traverse(child=>{if(child.geometry)child.geometry.dispose();});}
 const c=config(),w=c.internalWidthMm/1000,d=c.internalDepthMm/1000,h=c.internalHeightMm/1000;
 const W=w+.25,D=d+.3,H=h+.25,front=D/2;
 const color={Graphite:0x526577,Blue:0x276da5,'Light grey':0xaebbc8}[c.finish];const shell=mat(color),trim=mat(0x27394b,.7),inner=mat(0xb9c2cc,.2),orange=mat(0xf4a646,.2);
 cube(group,W,.13,D,0,.16,0,shell);cube(group,W,.13,D,0,H+.16,0,shell);
 cube(group,.13,H,D,-W/2,H/2+.2,0,shell);cube(group,.13,H,D,W/2,H/2+.2,0,shell);cube(group,W,H,.13,0,H/2+.2,-D/2,shell);
 cube(group,W-.3,H-.3,.035,0,H/2+.2,-D/2+.12,inner);
 cube(group,W,.08,.12,0,H+.18,front,trim);cube(group,W,.08,.12,0,.2,front,trim);
 cube(group,.08,H,.12,-W/2,.2+H/2,front,trim);cube(group,.08,H,.12,W/2,.2+H/2,front,trim);
 doorLeft=new THREE.Group();doorRight=new THREE.Group();doorLeft.position.set(-W/2,.2,front);doorRight.position.set(W/2,.2,front);group.add(doorLeft,doorRight);
 const half=W/2-.025;
 cube(doorLeft,half,H-.08,.085,half/2,H/2,0,shell);cube(doorRight,half,H-.08,.085,-half/2,H/2,0,shell);
 cube(doorLeft,.035,.33,.13,half-.17,H/2,0.1,trim);cube(doorRight,.035,.33,.13,-half+.17,H/2,0.1,trim);
 cube(group,.28,.25,.12,W/2-.26,H-.02,front+.04,trim);
 const led=new THREE.Mesh(new THREE.SphereGeometry(.035,12,12),new THREE.MeshBasicMaterial({color:0x61df91}));led.position.set(W/2-.3,H+.04,front+.115);group.add(led);
 if(c.heating==='Gas'||c.heating==='Hybrid')cube(group,.24,.42,.24,-W/2+.35,H+.55,-D/2+.45,trim);
 if(c.heating==='Electric'||c.heating==='Hybrid')cube(group,.55,.15,.32,W/2-.48,H+.31,-D/2+.5,orange);
 const feet=mat(0x303e4b,.7);for(const x of [-W/2+.25,W/2-.25])for(const z of [-D/2+.25,D/2-.25])cube(group,.18,.13,.18,x,.065,z,feet);
 doorLeft.rotation.y=doorsOpen?-Math.PI*.58:0;doorRight.rotation.y=doorsOpen?Math.PI*.58:0;
 for(const id of ['width','depth','height'])$(id+'-val').textContent=$(id).value+' mm';
 fitCamera();
 $('summary-text').textContent=`${c.internalWidthMm} × ${c.internalDepthMm} × ${c.internalHeightMm} mm (W × D × H) · ${c.heating} heating · ${c.finish} finish`;
}
for(const id of ['width','depth','height','heating','color'])$(id).addEventListener('input',rebuild);
$('toggle-doors').addEventListener('click',()=>{doorsOpen=!doorsOpen;$('toggle-doors').textContent=doorsOpen?'Close doors':'Open doors';rebuild();});
// Frame the complete oven in the center of the viewer, including on iPad/mobile.
function fitCamera(){
 // Fit a bounding sphere: works regardless of oven orientation and aspect ratio.
 group.updateWorldMatrix(true,true);
 const bounds=new THREE.Box3().setFromObject(group);
 if(bounds.isEmpty())return;
 const sphere=bounds.getBoundingSphere(new THREE.Sphere());
 const width=holder.clientWidth||600, height=holder.clientHeight||500;
 camera.aspect=width/height;
 const vFov=THREE.MathUtils.degToRad(camera.fov);
 const hFov=2*Math.atan(Math.tan(vFov/2)*camera.aspect);
 const limitingHalfFov=Math.min(vFov,hFov)/2;
 const distance=Math.max(5,sphere.radius/Math.sin(limitingHalfFov)*1.35);
 const direction=new THREE.Vector3(1,0.55,1).normalize();
 // Clear OrbitControls damping so old drag motion cannot shift the reset view.
 const damping=controls.enableDamping;
 controls.enableDamping=false;
 controls.target.copy(sphere.center);
 camera.position.copy(sphere.center).addScaledVector(direction,distance);
 camera.near=0.1;
 camera.far=Math.max(150,distance*8);
 camera.updateProjectionMatrix();
 camera.lookAt(sphere.center);
 controls.minDistance=2;
 controls.maxDistance=Math.max(40,distance*3);
 controls.update();
 controls.enableDamping=damping;
}
$('reset-camera').addEventListener('click',fitCamera);
$('quote').addEventListener('click',()=>{const c=config();const subject=encodeURIComponent('Quotation request — 3D curing oven configuration');const body=encodeURIComponent(`Hello,\n\nPlease quote the following configuration:\n\nMachine: ${c.machine}\nInternal width: ${c.internalWidthMm} mm\nInternal depth: ${c.internalDepthMm} mm\nInternal height: ${c.internalHeightMm} mm\nHeating: ${c.heating}\nFinish: ${c.finish}\nDoors: ${c.doors}\n\nPlease advise technical feasibility, pricing and lead time.\n\nName:\nCompany:\nCountry:\nPhone:\n`);window.location.href=`mailto:?subject=${subject}&body=${body}`;});
$('download').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({...config(),status:'Preliminary request — engineering verification required'},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='powceq-oven-configuration.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
const observer=new ResizeObserver(()=>{const width=holder.clientWidth,height=holder.clientHeight;if(width&&height){camera.aspect=width/height;camera.updateProjectionMatrix();renderer.setSize(width,height,false);fitCamera();}});observer.observe(holder);
rebuild();
fitCamera();

let frame;

function animate() {
  frame = requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}

animate();

window.addEventListener('pagehide', () => {
  cancelAnimationFrame(frame);
  observer.disconnect();
  controls.dispose();
  renderer.dispose();
}, { once: true });

}
</script>
