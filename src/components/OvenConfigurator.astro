<section class="shell">
  <header><div><small>POWCEQ · POWDER COATING EQUIPMENT</small><h1>3D Curing Oven Configurator</h1><p>Configure a powder coating oven and explore it in 3D.</p></div><button id="reset">Reset</button></header>
  <main><div class="viewer"><canvas id="oven" aria-label="Interactive 3D oven model"></canvas><div class="hint">Drag to rotate · Scroll or pinch to zoom</div></div><aside><h2>Configure your oven</h2><label>Width <output id="widthValue">2.0 m</output><input id="width" type="range" min="1.2" max="5" step="0.1" value="2"></label><label>Height <output id="heightValue">2.2 m</output><input id="height" type="range" min="1.5" max="4" step="0.1" value="2.2"></label><label>Depth <output id="depthValue">3.0 m</output><input id="depth" type="range" min="2" max="8" step="0.1" value="3"></label><label>Heating system<select id="heating"><option>Electric</option><option>Gas</option><option>Hybrid</option></select></label><label>Finish<select id="finish"><option value="silver">Industrial silver</option><option value="blue">POWCEQ blue</option><option value="dark">Graphite</option></select></label><div class="buttons"><button id="door">Open doors</button><button id="download">Download configuration</button></div><a id="quote" href="mailto:info@powceq.com">Request a quotation</a><p class="note">Conceptual visualization, not an engineering drawing. Dimensions are approximate in the preview.</p></aside></main>
</section>
<style>
*{box-sizing:border-box}.shell{max-width:1400px;margin:auto;padding:28px;color:#142033}header{display:flex;justify-content:space-between;align-items:center;gap:15px}small{letter-spacing:.14em;color:#2870aa;font-weight:700}h1{font-size:clamp(27px,4vw,43px);margin:8px 0}p{color:#5c6775}main{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(290px,1fr);gap:20px;margin-top:22px}.viewer{background:linear-gradient(#eaf1f7,#dce4eb);border-radius:18px;position:relative;min-height:550px;overflow:hidden}canvas{width:100%;height:550px;display:block;touch-action:none}.hint{position:absolute;bottom:15px;left:20px;color:#566577;font-size:13px}aside{background:white;border-radius:18px;padding:25px;box-shadow:0 8px 35px #243c5510}h2{margin-top:0}label{display:block;font-size:14px;font-weight:650;margin:20px 0}output{float:right;color:#2870aa}input,select{display:block;width:100%;margin-top:12px}select{padding:10px;border:1px solid #cad4dc;border-radius:8px;background:white}.buttons{display:grid;gap:10px}button,#quote{background:#1767a2;border:0;border-radius:9px;padding:12px 16px;color:white;cursor:pointer;font-weight:650;text-align:center;text-decoration:none}#reset,#door{background:#e4edf4;color:#163c59}#quote{display:block;margin-top:12px}.note{font-size:12px;line-height:1.5}@media(max-width:800px){main{grid-template-columns:1fr}.viewer,canvas{min-height:360px;height:420px}.shell{padding:15px}}
</style>
<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
const el=(id:string)=>document.getElementById(id)!;
const canvas=el('oven') as HTMLCanvasElement;
const scene=new THREE.Scene();scene.background=new THREE.Color(0xe7eef5);
const camera=new THREE.PerspectiveCamera(45,1,.1,100);camera.position.set(6,4.2,7);
const renderer=new THREE.WebGLRenderer({canvas,antialias:true});renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));renderer.shadowMap.enabled=true;
scene.add(new THREE.HemisphereLight(0xffffff,0x8ba0b4,2.2));const light=new THREE.DirectionalLight(0xffffff,2.4);light.position.set(5,9,7);light.castShadow=true;scene.add(light);
const ground=new THREE.Mesh(new THREE.PlaneGeometry(100,100),new THREE.MeshStandardMaterial({color:0xdce5eb}));ground.rotation.x=-Math.PI/2;ground.position.y=-.03;ground.receiveShadow=true;scene.add(ground);
const controls=new OrbitControls(camera,canvas);controls.enableDamping=true;controls.target.set(0,1.1,0);
let oven=new THREE.Group();scene.add(oven);let doors:THREE.Group[]=[];let isOpen=false;
const material=(color:number,metalness=.35)=>new THREE.MeshStandardMaterial({color,metalness,roughness:.45});
function panel(parent:THREE.Object3D,w:number,h:number,d:number,x:number,y:number,z:number,mat:THREE.Material){const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);mesh.position.set(x,y,z);mesh.castShadow=true;mesh.receiveShadow=true;parent.add(mesh);return mesh;}
function rebuild(){scene.remove(oven);oven=new THREE.Group();scene.add(oven);doors=[];const w=+(el('width') as HTMLInputElement).value,h=+(el('height') as HTMLInputElement).value,d=+(el('depth') as HTMLInputElement).value;const finish=(el('finish') as HTMLSelectElement).value;const base=material(finish==='blue'?0x216ba4:finish==='dark'?0x424b57:0xb9c3cd);const trim=material(0x34495a);const edge=.10;panel(oven,w,h,edge,0,h/2,-d/2,base);panel(oven,edge,h,d,-w/2,h/2,0,base);panel(oven,edge,h,d,w/2,h/2,0,base);panel(oven,w,edge,d,0,h,0,base);panel(oven,w,edge,d,0,edge/2,0,trim);panel(oven,w+.07,.09,.09,0,h-.07,d/2+.04,trim);const dw=w/2-.025;for(const side of [-1,1]){const hingeX=side*w/2;const doorGroup=new THREE.Group();doorGroup.position.set(hingeX,0,d/2);const centerX=-side*dw/2;panel(doorGroup,dw-.025,h-.16,.07,centerX,h/2,0,base);panel(doorGroup,.035,.35,.10,-side*(dw-.14),h/2,.09,trim);oven.add(doorGroup);doors.push(doorGroup);}const label=material(0xf5ad31,.05);panel(oven,.55,.12,.015,0,h-.3,d/2+.09,label);isOpen=false;el('door').textContent='Open doors';for(const k of ['width','height','depth'])el(k+'Value').textContent=(el(k) as HTMLInputElement).value+' m';}
function animate(){requestAnimationFrame(animate);doors.forEach((door,i)=>{const target=isOpen?(i===0?Math.PI*.68:-Math.PI*.68):0;door.rotation.y+=(target-door.rotation.y)*.12;});controls.update();renderer.render(scene,camera);}function resize(){const w=canvas.clientWidth,h=canvas.clientHeight;renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();}new ResizeObserver(resize).observe(canvas);resize();rebuild();animate();
for(const id of ['width','height','depth','finish'])el(id).addEventListener('input',rebuild);
el('door').addEventListener('click',()=>{isOpen=!isOpen;el('door').textContent=isOpen?'Close doors':'Open doors';});
function config(){return {width_m:Number((el('width') as HTMLInputElement).value),height_m:Number((el('height') as HTMLInputElement).value),depth_m:Number((el('depth') as HTMLInputElement).value),heating:(el('heating') as HTMLSelectElement).value,finish:(el('finish') as HTMLSelectElement).selectedOptions[0].text};}
el('download').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(config(),null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='powceq-oven-configuration.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
el('quote').addEventListener('click',()=>{const c=config();(el('quote') as HTMLAnchorElement).href='mailto:info@powceq.com?subject='+encodeURIComponent('POWCEQ oven quotation request')+'&body='+encodeURIComponent('Please quote the following oven configuration:\n'+JSON.stringify(c,null,2));});
el('reset').addEventListener('click',()=>{for(const [id,v] of Object.entries({width:'2',height:'2.2',depth:'3',heating:'Electric',finish:'silver'}))(el(id) as HTMLInputElement).value=v;rebuild();camera.position.set(6,4.2,7);controls.target.set(0,1.1,0);});
</script>
